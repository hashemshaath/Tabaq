# =============================================================================
# TABAQ — طبق — Complete Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# All variables are optional in development unless marked [REQUIRED].
# =============================================================================

# ── APPLICATION ───────────────────────────────────────────────────────────────

# Node environment: development | staging | production
NODE_ENV=development

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Port for the API server (Replit assigns this automatically)
PORT=8080

# Port for the frontend dev server
FRONTEND_PORT=5000

# Base path for the frontend (used by Vite, leave as / for root deployments)
BASE_PATH=/

# ── DATABASE ──────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/tabaq

# Connection pool settings (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# ── AUTHENTICATION ────────────────────────────────────────────────────────────

# [REQUIRED] JWT signing secret — use a long random string in production
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret_in_production

# JWT token expiry duration (e.g. 30d, 7d, 24h)
JWT_EXPIRES_IN=30d

# OTP code expiry in minutes
OTP_EXPIRY_MINUTES=10

# ── SMS / OTP PROVIDER ────────────────────────────────────────────────────────

# Provider to use for SMS: unifonic | twilio | mock (default: mock in dev)
SMS_PROVIDER=mock

# — Unifonic —
UNIFONIC_APP_SID=your_unifonic_app_sid
UNIFONIC_SENDER_ID=Tabaq

# — Twilio —
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Sender name shown to recipient (used by all providers)
SMS_FROM_NAME=Tabaq

# ── EMAIL / SMTP ──────────────────────────────────────────────────────────────

# SMTP server host
SMTP_HOST=smtp.sendgrid.net

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP credentials
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key

# From email address
SMTP_FROM_EMAIL=noreply@tabaq.sa
SMTP_FROM_NAME=Tabaq

# ── REDIS ─────────────────────────────────────────────────────────────────────

# Redis connection URL (used for rate limiting, caching, session store in prod)
# Leave empty to use in-memory stores in development
REDIS_URL=redis://localhost:6379

# Redis password (if required)
REDIS_PASSWORD=

# ── RATE LIMITING ─────────────────────────────────────────────────────────────

# Whether to trust the X-Forwarded-For header (set true behind load balancer/nginx)
TRUST_PROXY=false

# Max requests per window per IP on general public API routes
RATE_LIMIT_PUBLIC_MAX=200
RATE_LIMIT_PUBLIC_WINDOW_MS=60000

# Max requests per window on auth/OTP routes (stricter)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000

# Max requests per window on payment/sensitive routes
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_PAYMENT_WINDOW_MS=60000

# Max requests per window on search-heavy routes
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_MS=60000

# ── FILE STORAGE / UPLOADS ────────────────────────────────────────────────────

# Storage provider: local | s3 | r2 (default: local in dev)
STORAGE_PROVIDER=local

# Local storage: directory to store uploaded files (relative to project root)
STORAGE_LOCAL_DIR=./uploads

# Public base URL for uploaded files (used to construct image URLs)
# In production, point this to your CDN or storage bucket public URL
STORAGE_PUBLIC_URL=http://localhost:8080/uploads

# Max upload file size in bytes (default: 10 MB)
UPLOAD_MAX_SIZE_BYTES=10485760

# — AWS S3 —
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=me-south-1
AWS_S3_BUCKET=tabaq-uploads

# — Cloudflare R2 (S3-compatible) —
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=tabaq-uploads
# R2 public bucket domain (set after enabling public access on R2)
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── ERROR MONITORING (SENTRY) ─────────────────────────────────────────────────

# Sentry DSN for the backend API server
# Leave empty to disable Sentry (safe in development)
SENTRY_DSN=

# Sentry DSN for the frontend (React)
# Leave empty to disable Sentry in the browser
VITE_SENTRY_DSN=

# Sentry environment tag (development | staging | production)
SENTRY_ENVIRONMENT=development

# Sentry release version (usually set by CI/CD to the git SHA)
SENTRY_RELEASE=

# ── ANALYTICS ─────────────────────────────────────────────────────────────────

# Google Analytics 4 Measurement ID
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID
GTM_CONTAINER_ID=GTM-XXXXXXX

# Meta (Facebook) Pixel ID
META_PIXEL_ID=

# ── FIREBASE (PUSH NOTIFICATIONS) ────────────────────────────────────────────

# Firebase project configuration (from Firebase console → Project settings)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK service account JSON (base64-encoded for env safety)
# Generate with: base64 -i serviceAccountKey.json
FIREBASE_ADMIN_SDK_B64=

# ── PAYMENTS ──────────────────────────────────────────────────────────────────

# Payment gateway to use: mock | hyperpay | stripe (default: mock)
PAYMENT_GATEWAY=mock

# — HyperPay —
HYPERPAY_BASE_URL=https://oppwa.com
HYPERPAY_ACCESS_TOKEN=your_hyperpay_access_token
HYPERPAY_ENTITY_ID=your_hyperpay_entity_id

# — Stripe —
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── GOOGLE & APPLE OAUTH (MOBILE-FIRST) ──────────────────────────────────────

# Google OAuth 2.0 Client ID — from Google Cloud Console → Credentials
# Used to verify Google ID tokens sent by the mobile app
GOOGLE_CLIENT_ID=

# Apple Sign-In credentials — from Apple Developer Portal
# Bundle ID / Service ID registered for Sign In with Apple
APPLE_CLIENT_ID=
# Apple Developer Team ID (10-character string from developer.apple.com/account)
APPLE_TEAM_ID=
# Key ID of the Sign In with Apple private key (from Certificates, Identifiers & Profiles)
APPLE_KEY_ID=
# Private key content (PEM format) for Sign In with Apple
# Multiline value: wrap in quotes or base64-encode for env safety
APPLE_PRIVATE_KEY=

# ── MAPS ─────────────────────────────────────────────────────────────────────

# Google Maps API key (used for geocoding, distance calculation)
GOOGLE_MAPS_API_KEY=

# ── AI / OPENAI ───────────────────────────────────────────────────────────────

# OpenAI API key (used for recommendations and AI content generation)
# On Replit, this is provided automatically via the AI Integration — leave empty
OPENAI_API_KEY=

# OpenAI model to use
OPENAI_MODEL=gpt-4o-mini

# ── REPLIT-SPECIFIC (managed automatically) ───────────────────────────────────

# These are set automatically by Replit — do NOT set manually
# REPLIT_DEV_DOMAIN=your-repl.replit.dev
# REPLIT_DEPLOYMENT_URL=https://your-app.replit.app

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────

# Enable demo/seed data mode at startup (true | false)
DEMO_MODE=false

# Enable maintenance mode — returns 503 on all routes
MAINTENANCE_MODE=false

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of additional allowed CORS origins (besides Replit defaults)
# Example: CORS_EXTRA_ORIGINS=https://app.tabaq.sa,https://admin.tabaq.sa
CORS_EXTRA_ORIGINS=

# ── RABBITMQ (FUTURE — for async job queues) ──────────────────────────────────

# RabbitMQ connection URL (leave empty if not using message queue yet)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── SENTRY RELEASE (CI/CD) ───────────────────────────────────────────────────

# Set these in your CI pipeline for proper release tracking
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=tabaq-api
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
