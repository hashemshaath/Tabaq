###############################################################################
# Tabaq API Server — Production Dockerfile
# Build context: repository root (monorepo)
###############################################################################

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

# ── Dependencies layer ────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/package.json ./lib/db/
COPY lib/db/src ./lib/db/src
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-zod/src ./lib/api-zod/src
COPY lib/api-client-react/package.json ./lib/api-client-react/ 2>/dev/null || true
COPY artifacts/api-server/package.json ./artifacts/api-server/

# Install production deps only
RUN pnpm install --frozen-lockfile --prod

# ── Build layer ───────────────────────────────────────────────────────────────
FROM deps AS builder
# Install dev deps too (needed for build tools like esbuild)
RUN pnpm install --frozen-lockfile

COPY lib/ ./lib/
COPY artifacts/api-server/ ./artifacts/api-server/

# Build the API server bundle
RUN pnpm --filter @workspace/api-server run build

# ── Production image ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

# Create non-root user for security
RUN addgroup --system --gid 1001 tabaq && \
    adduser --system --uid 1001 --ingroup tabaq tabaq

# Copy built output + production node_modules
COPY --from=builder --chown=tabaq:tabaq /app/artifacts/api-server/dist ./dist
COPY --from=builder --chown=tabaq:tabaq /app/artifacts/api-server/node_modules ./node_modules
COPY --from=builder --chown=tabaq:tabaq /app/node_modules /app/node_modules

# Create uploads directory for local storage
RUN mkdir -p /app/uploads && chown tabaq:tabaq /app/uploads

USER tabaq

ENV NODE_ENV=production
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/api/health || exit 1

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
