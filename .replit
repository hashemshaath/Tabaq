modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/tabaq run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
JWT_EXPIRES_IN = "30d"
OTP_EXPIRY_MINUTES = "10"
JWT_SECRET = "c77cdd5a7b94b574e0adc000aec729f278d6cfd1480243ea92e01a0144f3c637107ce50792ec3cd573cf5861dbfb3f92a5896fe4cc1815b87ec2c5bbf05fc1f8"
JWT_REFRESH_SECRET = "622efcf312cfc2faf765c5e8b8d744224c8149b333e581470cea9284a64546f1bddf08f936608a9a2c1062e4d4558e5d974170f007d7b25722693b399a33b95c"
SESSION_CLEANUP_CRON = "0 2 * * *"
BCRYPT_SALT_ROUNDS = "12"
OTP_MAX_ATTEMPTS = "3"
