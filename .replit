modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
JWT_EXPIRES_IN = "30d"
OTP_EXPIRY_MINUTES = "10"
JWT_SECRET = "c77cdd5a7b94b574e0adc000aec729f278d6cfd1480243ea92e01a0144f3c637107ce50792ec3cd573cf5861dbfb3f92a5896fe4cc1815b87ec2c5bbf05fc1f8"
