###############################################################################
# Tabaq Frontend (React + Vite) — Production Dockerfile
# Build context: repository root (monorepo)
###############################################################################

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

# ── Dependencies layer ────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-zod/src ./lib/api-zod/src
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-client-react/src ./lib/api-client-react/src
COPY artifacts/tabaq/package.json ./artifacts/tabaq/

RUN pnpm install --frozen-lockfile

# ── Build layer ───────────────────────────────────────────────────────────────
FROM deps AS builder

COPY lib/ ./lib/
COPY artifacts/tabaq/ ./artifacts/tabaq/

# Build the Vite app — output goes to artifacts/tabaq/dist
ARG VITE_API_URL=/api
ARG VITE_SENTRY_DSN=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN

RUN pnpm --filter @workspace/tabaq run build

# ── Production image (nginx) ──────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy built frontend
COPY --from=builder /app/artifacts/tabaq/dist /usr/share/nginx/html

# nginx config: serve SPA, proxy /api to the API service
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
